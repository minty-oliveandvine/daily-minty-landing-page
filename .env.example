# Public - inlined into the client bundle at build time. All optional; the
# defaults are in src/config/site.ts.
#
# WWW_URL is this site's own canonical address (the canonical tag, og:url, robots.txt and
# sitemap.xml). www, not the apex - dailyminty.com redirects here. Read server-side only, so
# it needs no NEXT_PUBLIC_ prefix.
WWW_URL=https://www.dailyminty.com
# WAITLIST_URL is read in client components, so it is listed in next.config.mjs's `env` to be
# inlined without the prefix. The two NEXT_PUBLIC_ names below still rely on the prefix.
WAITLIST_URL=https://www.minty.oliveandvinehk.com/
NEXT_PUBLIC_WAITLIST_FORM_URL=https://forms.clickup.com/9008167462/f/8ceveh6-19038/4A7KI514BG030HAP22
NEXT_PUBLIC_CONTACT_EMAIL=hello@dailyminty.com

# Server only - the contact form (src/app/api/contact) sends through Microsoft
# Graph with an app registration that has Mail.Send on CONTACT_MAILBOX. All
# four are required; src/lib/graph-mailer.ts refuses to start without them.
# Never commit real values. See docs/contact-form-implementation.md.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
CONTACT_MAILBOX=hello@dailyminty.com
